# Turns the authored frontend files into C++ string literals so the Android
# binary needs no asset manager plumbing and the desktop server needs no paths.
#
# Invoked as:
#   cmake -DSHELL_FILE=... -DCSS_FILE=... -DOUTPUT=... -P embed_assets.cmake

if(NOT DEFINED SHELL_FILE OR NOT DEFINED CSS_FILE OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "embed_assets.cmake needs SHELL_FILE, CSS_FILE and OUTPUT")
endif()

file(READ "${SHELL_FILE}" SHELL_CONTENT)
file(READ "${CSS_FILE}" CSS_CONTENT)

file(WRITE "${OUTPUT}" "// Generated by cmake/embed_assets.cmake -- do not edit.
namespace wechess {
namespace assets {

const char* shellHtml() {
    static const char* value = R\"WECHESS_SHELL(${SHELL_CONTENT})WECHESS_SHELL\";
    return value;
}

const char* stylesheet() {
    static const char* value = R\"WECHESS_CSS(${CSS_CONTENT})WECHESS_CSS\";
    return value;
}

}  // namespace assets
}  // namespace wechess
")
